{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "baseUrl": "./",
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@ia/*": ["./ia/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "ia/**/*.ts",
    ".opencode/**/*.ts",
    "jest.setup.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".expo", "dist", "coverage", "android", "ios"]
}
