{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@ia/*": ["./ia/*"]
    }
  },
  "include": ["ia/**/*.ts", ".opencode/**/*.ts"],
  "exclude": ["node_modules", ".expo", "app", "src", "__tests__"]
}
