# Copia este archivo a .env (nunca lo subas a git) y llena los valores.
# Los agentes de IA NO leen ni crean el .env real; solo este ejemplo.

# URL pública de la API (NO es un secreto, pero queda DENTRO del APK).
# Sin barra final. En producción siempre HTTPS: nada de localhost en el APK.
EXPO_PUBLIC_API_URL=https://tu-api.vercel.app

# No se agrega ninguna otra variable EXPO_PUBLIC_* con credenciales:
# las claves de Firebase y los secretos viven solo en la API (Vercel).
