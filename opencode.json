{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.keystore": "deny",
      "*.jks": "deny",
      "google-services.json": "deny",
      "GoogleService-Info.plist": "deny",
      "*service-account*.json": "deny",
      "secrets/**": "deny",
      "data/**": "deny",
      "../*/**": "deny",
      "../boton-de-seguridad-api/.env*": "deny",
      "../boton-de-seguridad-api/secrets/**": "deny",
      "../boton-de-seguridad-api/data/**": "deny",
      "../boton-de-seguridad-api/**": "allow"
    },
    "edit": {
      "*": "allow",
      "../*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.keystore": "deny",
      "*.jks": "deny",
      "*.p12": "deny",
      "secrets/**": "deny",
      "data/**": "deny",
      "opencode.json": "ask",
      "AGENTS.md": "ask",
      ".opencode/**": "ask",
      "app.json": "ask",
      "eas.json": "ask",
      "../*/**": "deny",
      "../boton-de-seguridad-api/.env*": "deny",
      "../boton-de-seguridad-api/secrets/**": "deny",
      "../boton-de-seguridad-api/data/**": "deny",
      "../boton-de-seguridad-api/**": "allow"
    },
    "bash": {
      "*": "ask",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run check*": "allow",
      "npm run format*": "allow",
      "npx jest*": "allow",
      "npx tsc*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "cat *.env*": "deny",
      "type *.env*": "deny",
      "Get-Content *.env*": "deny",
      "grep * .env*": "deny",
      "printenv*": "deny",
      "env": "deny",
      "cd ..": "deny",
      "git push*": "deny",
      "eas build*": "deny",
      "eas submit*": "deny",
      "expo publish*": "deny",
      "vercel*": "deny",
      "npm publish*": "deny",
      "rm -rf*": "deny",
      "Remove-Item -Recurse*": "deny"
    },
    "webfetch": "ask"
  }
}
