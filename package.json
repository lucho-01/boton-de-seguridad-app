{
  "name": "boton-de-seguridad-app",
  "version": "0.1.0",
  "private": true,
  "description": "App móvil del proyecto 36 · Botón de seguridad con contactos de confianza",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.cjs"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/jest.stubs/"
    ],
    "moduleNameMapper": {
      "^@/contracts/(.*)$": "<rootDir>/src/api/contracts/$1",
      "^@/contracts$": "<rootDir>/src/api/contracts",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@ia/(.*)$": "<rootDir>/ia/$1",
      "^react-native-reanimated$": "<rootDir>/jest.stubs/reanimated.mjs",
      "^react-native-reanimated/mock$": "<rootDir>/jest.stubs/reanimated.mjs",
      "^react-native-worklets((/.*)?)$": "<rootDir>/jest.stubs/worklets.mjs"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-gesture-handler|react-native-reanimated|standard-navigation|expo-router/.*))"
    ]
  },
  "dependencies": {
    "expo": "^58.0.25",
    "expo-battery": "~58.0.4",
    "expo-haptics": "~58.0.8",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-sms": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-modules-commonjs": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": "24.x"
  }
}
